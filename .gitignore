# ---------------------------------------------------------------
# .gitignore - support-triage
# The idea: code, notebooks and documentation go into git. Data, models,
# working environments and operating-system junk do not.
# ---------------------------------------------------------------

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
conda-env/

# Testing / linting tools
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ===== Jupyter =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb
profile_default/
ipython_config.py

# ===== Data =====
# The raw dataset is not committed - it is 19 MB and one call re-downloads it.
# The split IS committed: see the block below the rules for why.
# Warning to self (and to Claude): do not add an exception here that un-ignores
# a whole directory (for example "!data/processed/clean/") in order to "keep the
# folder structure" - a directory-level exception cancels the filter for every
# file placed inside it afterwards, not just for the directory itself.
# To preserve empty directories use .gitkeep only, which is already exempted below.
# If a specific file really is needed (such as split_manifest.json), exempt it
# by its full filename, not by the directory that contains it.
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep
!data/**/README.md
!data/processed/split_manifest.json

# The six split CSVs and the corpus registry are committed - 6 MB in total.
# They were handed over through Drive at first, and that breaks the moment
# somebody who is not the author opens the project: a fresh clone has no data,
# and a folder only one person can see is not a reproducible dataset. Rebuilding
# them instead is worse - a rebuild under different library versions can allocate
# one row differently, and then the numbers in the report describe data nobody
# has. In git, the rows and their sha256 fingerprints in split_manifest.json sit
# in the same commit, so "which data produced these numbers" has an answer.
# The rules are shaped the way they are because a file cannot be un-ignored while
# the directory above it is ignored: the two split directories are re-admitted
# first and their contents ignored again, which keeps the exemption at the level
# of *.csv rather than the whole directory (see the warning above).
!data/processed/clean/
!data/processed/naive/
data/processed/clean/*
data/processed/naive/*
!data/processed/clean/*.csv
!data/processed/naive/*.csv
!data/processed/full_corpus.csv

# naive_sub/ - the size control, admitted with the same three-line pattern and
# for the same reason. It is naive/train cut to clean/train's row count, and it
# is committed rather than redrawn because a redraw has the right row count,
# the right class balance and the wrong rows: nothing raises, and every number
# measured against it stops being comparable to day 2's. Its manifest is
# exempted by full filename, not by admitting the directory - see the warning
# at the top of this section.
!data/processed/naive_sub/
data/processed/naive_sub/*
!data/processed/naive_sub/*.csv
!data/processed/naive_sub/subsample_manifest.json

# Heavy data formats, anywhere in the project
*.parquet
*.feather
*.arrow
*.hdf
*.h5
*.sqlite
*.sqlite3
*.db
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ===== Models and heavy outputs =====
artifacts/*
!artifacts/.gitkeep
# The two contract files must specifically be in git:
# they are tiny, and they define the class order the model returns. If they are
# not in the repo, a saved checkpoint returns wrong answers without any error.
# Again - exempt by full filename, not by a directory-level exception.
!artifacts/labels.json
!artifacts/intent2cat.json
# The freeze record is a third one, and it was missing here until day 4 proved
# why that matters. 03b writes artifacts/config_freeze.json, prints "COMMIT THESE
# BEFORE RUNNING THE NEXT CELL", and then lists what `git status` can see - which
# did not include the freeze, because of the rule four lines above. It was written,
# it was never committed, and nothing said so. It records which r was chosen and
# the pre-registered rule that chose it, which is the difference between a decision
# and three numbers, so it belongs in git for the same reason the other two do.
!artifacts/config_freeze.json
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.safetensors
*.model
*.vec
# Embeddings / cache of pretrained models
.cache/
cache/
transformers_cache/
sentence_transformers_cache/
nltk_data/
mlruns/
wandb/

# LoRA adapters. On Colab these go to Drive; _local_runs/ is the fallback the
# training notebook uses when it is not running in Colab. An adapter is a
# training OUTPUT, not code - the repo keeps the run's JSON record instead.
_local_runs/

# ===== Results =====
# results/ IS kept in git (small figures and metrics = part of the documentation
# for submission), but without temporary/huge files:
results/**/*.tmp
results/**/*.log
logs/
*.log

# ===== Secrets =====
.env
.env.*
!.env.example
secrets.json
*.key
*.pem
credentials*.json

# ===== Editors and IDEs =====
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject

# ===== Operating system / OneDrive =====
# Particularly important because the project lives inside OneDrive
desktop.ini
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
._*
*.lnk
# OneDrive sync-conflict files.
# The second pattern is the Hebrew-locale equivalent of " - Copy" and must stay
# in Hebrew: it matches filenames Windows generates, not text we wrote.
*-emma-pc.*
* - Copy.*
* - עותק.*

# ===== Miscellaneous =====
*.bak
*.tmp
temp/
tmp/
scratch/

